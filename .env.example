# Copy to .env.dev. This is trusted local shell configuration, ignored by Git.
# API-key development uses the model configuration without a JS runtime.
# DIMCODE_MODEL_CONFIG=/absolute/path/to/model.json
# OPENAI_API_KEY=your-key

# Optional paired default for new chats; login and resumed sessions omit it.
# DIMCODE_PROVIDER=provider-id
# DIMCODE_MODEL=model-id

# Optional Web workspace directory replacing the embedded build (frontend development).
# DIMCODE_WEB_ASSETS=/absolute/path/to/web/dist

# Dim account OAuth client IDs; with both set, dimcode is built as the account build.
# Never commit them; releases read them from the repository's secrets.
# DIM_OAUTH_CLIENT_ID_CN=
# DIM_OAUTH_CLIENT_ID_GLOBAL=

# Optional isolated development home. Keep Unix socket paths short.
# DIMCODE_HOME=/absolute/path/to/development-home
