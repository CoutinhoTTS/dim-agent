# Rename only when release publication is explicitly enabled.
name: Publish GitHub release
on:
  workflow_dispatch:
    inputs:
      build_run_id:
        description: Successful release.yml build run
        required: true
        type: string
      npm_publish_run_id:
        description: Successful npm-publish.yml run for that build
        required: true
        type: string
permissions:
  contents: read
  actions: read
jobs:
  publish:
    if: ${{ github.repository == 'arcships/dim' && startsWith(github.ref, 'refs/tags/v') }}
    runs-on: ubuntu-latest
    environment: github-release
    permissions:
      contents: write
      actions: read
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - name: Verify build and npm publication
        env:
          GH_TOKEN: ${{ github.token }}
          BUILD_RUN_ID: ${{ inputs.build_run_id }}
          NPM_RUN_ID: ${{ inputs.npm_publish_run_id }}
        shell: bash
        run: |
          set -euo pipefail
          [[ "$BUILD_RUN_ID" =~ ^[1-9][0-9]*$ && "$NPM_RUN_ID" =~ ^[1-9][0-9]*$ ]]
          for kind in build npm; do
            if [[ "$kind" == build ]]; then run_id=$BUILD_RUN_ID; workflow=release.yml; else run_id=$NPM_RUN_ID; workflow=npm-publish.yml; fi
            gh api "repos/$GITHUB_REPOSITORY/actions/runs/$run_id" > "$RUNNER_TEMP/$kind-run.json"
            jq -e --arg sha "$GITHUB_SHA" --arg repo "$GITHUB_REPOSITORY" '
              .status == "completed" and .conclusion == "success" and .head_sha == $sha
              and .head_repository.full_name == $repo and .event == "workflow_dispatch"
            ' "$RUNNER_TEMP/$kind-run.json" > /dev/null
            workflow_id=$(jq -er '.workflow_id' "$RUNNER_TEMP/$kind-run.json")
            gh api "repos/$GITHUB_REPOSITORY/actions/workflows/$workflow_id" |
              jq -e --arg path ".github/workflows/$workflow" '.path == $path' > /dev/null
          done
      - uses: actions/download-artifact@v8
        with:
          name: native-packages
          path: staging/native
          run-id: ${{ inputs.build_run_id }}
          github-token: ${{ github.token }}
          digest-mismatch: error
      - uses: actions/setup-node@v6
        with:
          node-version-file: .node-version
          package-manager-cache: false
      - uses: actions/download-artifact@v8
        with:
          name: npm-publication
          path: staging/publication
          run-id: ${{ inputs.npm_publish_run_id }}
          github-token: ${{ github.token }}
          digest-mismatch: error
      - name: Verify and publish native archives
        env:
          GH_TOKEN: ${{ github.token }}
          BUILD_RUN_ID: ${{ inputs.build_run_id }}
        shell: bash
        run: |
          set -euo pipefail
          node scripts/check-native.mjs staging/native "${GITHUB_REF_NAME#v}" "$GITHUB_SHA" staging/publication/npm-publication.json "$BUILD_RUN_ID"
          if gh release view "$GITHUB_REF_NAME" > /dev/null 2>&1; then
            echo 'Release already exists; inspect it before retrying.' >&2
            exit 1
          fi
          flags=()
          if [[ "$GITHUB_REF_NAME" == *-* ]]; then flags+=(--prerelease); fi
          gh release create "$GITHUB_REF_NAME" staging/native/* --verify-tag --generate-notes "${flags[@]}"
