# Rename only when release builds are explicitly enabled.
name: Build release artifacts
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: release-${{ github.ref }}
  cancel-in-progress: false
jobs:
  build:
    if: ${{ github.repository == 'arcships/dim' && startsWith(github.ref, 'refs/tags/v') }}
    environment: release-build
    strategy:
      fail-fast: false
      matrix:
        include:
          - platform: darwin-arm64
            target: aarch64-apple-darwin
            runner: dim-release-darwin-arm64
          - platform: darwin-x64
            target: x86_64-apple-darwin
            runner: dim-release-darwin-x64
          - platform: linux-arm64
            target: aarch64-unknown-linux-gnu
            runner: dim-release-linux-arm64
          - platform: linux-x64
            target: x86_64-unknown-linux-gnu
            runner: dim-release-linux-x64
          - platform: windows-x64
            target: x86_64-pc-windows-msvc
            runner: dim-release-windows-x64
    runs-on: [self-hosted, '${{ matrix.runner }}']
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - uses: actions/setup-node@v6
        with:
          node-version-file: .node-version
          package-manager-cache: false
      - name: Build and stage native payload
        env:
          DIM_BUILD_PLATFORM: ${{ matrix.platform }}
          DIM_BUILD_TARGET: ${{ matrix.target }}
          DIM_OAUTH_PACKAGE_URL: ${{ vars.DIM_OAUTH_PACKAGE_URL }}
          DIM_OAUTH_PACKAGE_SHA256: ${{ vars.DIM_OAUTH_PACKAGE_SHA256 }}
          DIM_OAUTH_DOWNLOAD_TOKEN: ${{ secrets.DIM_OAUTH_DOWNLOAD_TOKEN }}
        shell: bash
        run: |
          set -euo pipefail
          unset RUSTC_WRAPPER
          export CARGO_INCREMENTAL=0
          node --input-type=module -e 'import assert from "node:assert/strict";assert.equal((process.platform==="win32"?"windows":process.platform)+"-"+process.arch,process.env.DIM_BUILD_PLATFORM,"Runner architecture mismatch");'
          cargo build --release --locked --target "$DIM_BUILD_TARGET" -p dim-cli -p dim-app-server
          cargo test --locked -p dim-cli
          node scripts/stage-release.mjs "target/$DIM_BUILD_TARGET/release" "staging/${{ matrix.platform }}" "${GITHUB_REF_NAME#v}" "$GITHUB_SHA" --with-plugin
          node scripts/pack-release.mjs "staging/${{ matrix.platform }}" "release/${{ matrix.platform }}"
      - uses: actions/upload-artifact@v7
        with:
          name: release-${{ matrix.platform }}
          path: release/${{ matrix.platform }}/
          if-no-files-found: error
          retention-days: 14
          compression-level: 0
  collect:
    needs: build
    runs-on: [self-hosted, dim-release-linux-x64]
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - uses: actions/setup-node@v6
        with:
          node-version-file: .node-version
          package-manager-cache: false
      - uses: actions/download-artifact@v8
        with:
          pattern: release-*
          path: staging/platforms
          digest-mismatch: error
      - name: Verify platform provenance and collect packages
        shell: bash
        run: node scripts/collect-release.mjs staging/platforms staging/complete
      - uses: actions/upload-artifact@v7
        with:
          name: npm-packages
          path: staging/complete/npm/
          if-no-files-found: error
          retention-days: 14
          compression-level: 0
      - uses: actions/upload-artifact@v7
        with:
          name: native-packages
          path: staging/complete/native/
          if-no-files-found: error
          retention-days: 14
          compression-level: 0
