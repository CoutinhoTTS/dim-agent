{
  "id": "web",
  "name": "@dimcode/web",
  "group": "session",
  "config": {},
  "inject": ["settings"],
  "provides": {
    "toolContribution:web_search": {"declaration": "sync", "execute": "async"},
    "toolContribution:web_fetch": {"declaration": "sync", "execute": "async"}
  },
  "settings": [{
    "source": "web",
    "userFile": "web.json",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "searchService": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "endpoint": {"type": "string", "format": "uri"},
            "apiKey": {"type": "string", "minLength": 1}
          }
        },
        "allowPrivateHosts": {"type": "array", "items": {"type": "string"}, "default": []},
        "proxy": {"type": "string", "format": "uri"}
      }
    },
    "userOnly": ["/searchService", "/allowPrivateHosts"]
  }]
}
