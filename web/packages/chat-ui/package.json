{
  "name": "@dimcode/chat-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles/chat-ui.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/check-bundle-budget.mjs",
    "lint": "oxlint src tests scripts vite.config.ts vitest.config.ts",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "remove-markdown": "^0.6.4"
  },
  "peerDependencies": {
    "@pierre/diffs": "^1.2.12",
    "markstream-vue": "^2.0.19",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.2.12",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/server-renderer": "^3.5.35",
    "jsdom": "^26.1.0",
    "markstream-vue": "^2.0.19",
    "oxlint": "^1.68.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.8",
    "vue": "^3.5.35",
    "vue-tsc": "^2.2.12"
  }
}
